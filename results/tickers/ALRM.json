ome builder program hardware and services. The company was founded in 2000 and is headquartered in Tysons, Virginia."},"stats":{"price":55.665,"marketCap":2732607488.0,"revenueGrowth":0.092,"operatingMargins":0.15068,"fcfMargin":0.09439032445352616,"netCash":-86147008.0,"trailingPE":24.630531,"priceToSales":2.5755408,"beta":0.757,"debtToEquity":0.62337,"fiftyTwoWeekLow":41.49,"fiftyTwoWeekHigh":58.145,"avgVolume":424226.0},"bars":[{"d":"2025-10-06","o":52.65,"h":52.65,"l":51.77,"c":52.315,"v":348800},{"d":"2025-10-07","o":52.28,"h":52.28,"l":51.07,"c":51.41,"v":330100},{"d":"2025-10-08","o":51.68,"h":52.03,"l":51.27,"c":51.84,"v":275500},{"d":"2025-10-09","o":51.84,"h":52.295,"l":51.32,"c":52.23,"v":301200},{"d":"2025-10-10","o":52.13,"h":52.425,"l":49.64,"c":49.88,"v":351100},{"d":"2025-10-13","o":50.46,"h":50.52,"l":49.32,"c":49.46,"v":308800},{"d":"2025-10-14","o":48.94,"h":50.225,"l":48.67,"c":50.12,"v":377000},{"d":"2025-10-15","o":50.45,"h":51.14,"l":50.01,"c":51.14,"v":382900},{"d":"2025-10-16","o":51.1,"h":51.19,"l":50.27,"c":50.59,"v":241200},{"d":"2025-10-17","o":50.06,"h":50.69,"l":49.66,"c":49.72,"v":306800},{"d":"2025-10-20","o":49.98,"h":50.5,"l":49.7,"c":50.33,"v":224800},{"d":"2025-10-21","o":50.29,"h":51.49,"l":50.025,"c":51.16,"v":293500},{"d":"2025-10-22","o":51.07,"h":51.825,"l":50.68,"c":51.04,"v":367300},{"d":"2025-10-23","o":50.92,"h":51.265,"l":50.47,"c":50.99,"v":225900},{"d":"2025-10-24","o":51.36,"h":51.82,"l":51.23,"c":51.75,"v":232200},{"d":"2025-10-27","o":51.75,"h":52.067,"l":51.15,"c":51.5,"v":209400},{"d":"2025-10-28","o":51.5,"h":52.39,"l":51.15,"c":51.94,"v":323800},{"d":"2025-10-29","o":51.62,"h":51.805,"l":49.07,"c":49.1,"v":528500},{"d":"2025-10-30","o":48.97,"h":49.45,"l":48.39,"c":49.09,"v":470000},{"d":"2025-10-31","o":48.83,"h":49.57,"l":48.365,"c":49.22,"v":318900},{"d":"2025-11-03","o":49.33,"h":49.515,"l":48.555,"c":49.07,"v":285400},{"d":"2025-11-04","o":48.72,"h":49.035,"l":48.1,"c":48.51,"v":332200},{"d":"2025-11-05","