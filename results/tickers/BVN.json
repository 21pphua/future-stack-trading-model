{"ticker":"BVN","generated_at_utc":"2026-10-27T01:07:55.825481Z","profile":{"name":"Compa\u00f1\u00eda de Minas Buenaventura S.A.A.","exchange":"NYSE","country":"Peru","sector":"Basic Materials","industry":"Other Precious Metals & Mining","website":"https://buenaventura.com","summary":"Compa\u00f1\u00eda de Minas Buenaventura S.A.A., together with its subsidiaries, engages in the exploration, development, construction, and operation of mines in Peru, the Americas, Europe, and Asia. It explores for gold, silver, copper, zinc, lead, and antimony deposits. The company also engages in the exploration, extraction, concentration, smelting, and marketing of polymetallic minerals and metals. In addition, it is involved in electricity transmission and generation; hydroelectric plant operation; and production of manganese sulfate monohydrate, as well as tailings dam management. The company was incorporated in 1953 and is based in Lima, Peru."},"stats":{"price":28.44,"marketCap":7223386624.0,"revenueGrowth":0.432,"operatingMargins":0.41849998,"fcfMargin":0.06332696942506622,"netCash":66553024.0,"trailingPE":6.4636364,"priceToSales":3.2714837,"beta":0.416,"debtToEquity":0.15216,"fiftyTwoWeekLow":21.0,"fiftyTwoWeekHigh":44.67,"avgVolume":1018489.0},"bars":[{"d":"2025-10-27","o":22.08,"h":22.27,"l":21.01,"c":21.5,"v":1632900},{"d":"2025-10-28","o":21.21,"h":22.18,"l":21.0,"c":22.11,"v":1152300},{"d":"2025-10-29","o":22.91,"h":22.91,"l":22.11,"c":22.26,"v":856300},{"d":"2025-10-30","o":22.14,"h":23.0,"l":22.05,"c":22.73,"v":977600},{"d":"2025-10-31","o":22.9,"h":23.73,"l":22.15,"c":22.77,"v":2877700},{"d":"2025-11-03","o":22.86,"h":23.08,"l":21.86,"c":21.92,"v":908600},{"d":"2025-11-04","o":21.35,"h":21.65,"l":21.04,"c":21.16,"v":861400},{"d":"2025-11-05","o":21.68,"h":21.98,"l":21.26,"c":21.68,"v":805600},{"d":"2025-11-06","o":22.02,"h":22.86,"l":21.69,"c":21.7,"v":723900},{"d":"2025-11-07","o":21.82,"h":22.49,"l":21.68,"c":22.37,"v":592000},{"d":"2025-11-10","o":23.23,"h":23.6,"