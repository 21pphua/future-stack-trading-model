ames. The company serves customers in technology, healthcare, financial services, consumer and retail, industrial, and non-profit industries, as well as government. The company was incorporated in 2009 and is headquartered in San Francisco, California."},"stats":{"price":362.45,"marketCap":129061093376.0,"revenueGrowth":0.359,"operatingMargins":-0.07603,"fcfMargin":0.27541798762913744,"netCash":633448192.0,"trailingPE":null,"priceToSales":51.370667,"beta":1.645,"debtToEquity":2.17858,"fiftyTwoWeekLow":158.83,"fiftyTwoWeekHigh":367.43,"avgVolume":3391164.0},"bars":[{"d":"2025-10-06","o":219.5,"h":225.371,"l":219.215,"c":221.03,"v":1957500},{"d":"2025-10-07","o":222.0,"h":222.22,"l":213.68,"c":217.39,"v":2138900},{"d":"2025-10-08","o":218.71,"h":221.99,"l":216.2,"c":220.0,"v":1970600},{"d":"2025-10-09","o":218.76,"h":221.522,"l":214.3,"c":220.95,"v":1478400},{"d":"2025-10-10","o":222.12,"h":226.95,"l":213.15,"c":213.82,"v":2118500},{"d":"2025-10-13","o":217.26,"h":223.7,"l":215.85,"c":222.56,"v":1824300},{"d":"2025-10-14","o":217.33,"h":217.96,"l":210.33,"c":217.55,"v":2645700},{"d":"2025-10-15","o":220.99,"h":225.01,"l":217.26,"c":217.38,"v":2168000},{"d":"2025-10-16","o":218.78,"h":221.46,"l":209.14,"c":211.4,"v":2588400},{"d":"2025-10-17","o":208.225,"h":210.08,"l":203.51,"c":210.01,"v":3070700},{"d":"2025-10-20","o":212.41,"h":213.45,"l":208.8,"c":213.04,"v":2008000},{"d":"2025-10-21","o":213.195,"h":213.73,"l":208.17,"c":212.98,"v":1395400},{"d":"2025-10-22","o":211.92,"h":213.83,"l":206.29,"c":210.73,"v":1684700},{"d":"2025-10-23","o":210.73,"h":217.29,"l":210.01,"c":217.16,"v":2108000},{"d":"2025-10-24","o":220.1,"h":222.13,"l":217.76,"c":217.85,"v":1357700},{"d":"2025-10-27","o":222.44,"h":225.44,"l":219.29,"c":225.11,"v":2085900},{"d":"2025-10-28","o":226.25,"h":228.2,"l":223.75,"c":223.99,"v":1864300},{"d":"2025-10-29","o":224.65,"h":227.93,"l":223.01,"c":227.38,"v":2253200},{"d":"2025-10-30","o":226.14,"h":231.13,"l":222.25,"c":222.5,"v":5282000},{"d":"2025